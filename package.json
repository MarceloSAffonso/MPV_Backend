{
  "name": "tere-verde-online",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply tere-verde --local",
    "db:migrate:remote": "wrangler d1 migrations apply tere-verde --remote",
    "db:admin:local": "node scripts/make-admin.mjs --local",
    "db:admin:remote": "node scripts/make-admin.mjs --remote",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.7.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "hono": "^4.9.0",
    "lucide-react": "^1.61.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.13.0",
    "@cloudflare/vitest-plugin": "^1.4.7",
    "@cloudflare/vitest-pool-workers": "^0.23.0",
    "@cloudflare/workers-types": "^5.20261019.1",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.9.0",
    "vite": "^7.1.0",
    "vitest": "^4.1.12",
    "wrangler": "^4.40.0"
  }
}
